<!doctype html>
<html{% if request.design_mode %} class="shopify-design-mode"{% endif %} lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
  <head>
    {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
    {% render 'view-transition-opt-in' %}
    {% render 'meta-tags' %}
    {% render 'stylesheets' %}
    {% render 'scripts' %}
    {% render 'theme-styles-variables' %}
    {% render 'color-palette' %}
    {% render 'facelove-design' %}
    {% if request.design_mode %}{% render 'theme-editor' %}{% endif %}
    {{ content_for_header }}
  </head>
  <body class="facelove-landing page-width-{{ settings.page_width }}" style="--header-height: 0px; --header-group-height: 0px;">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div class="page-wrapper">
      <main id="MainContent" class="content-for-layout" role="main" data-page-transition-enabled="{{ settings.page_transition_enabled }}" data-product-transition="{{ settings.transition_to_main_product }}" data-template="{{ template }}">
        {{ content_for_layout }}
      </main>
      <div data-sticky-end aria-hidden="true"></div>
    </div>
    {% comment %} Keep native purchase feedback available in this dedicated landing layout. {% endcomment %}
    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}
  </body>
</html>
