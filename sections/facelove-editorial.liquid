{% comment %}
  Product storytelling with merchant-owned media and copy, plus native disclosures.
  @example
  Add an editorial section to the product template and choose its content layout.
{% endcomment %}
{% render 'facelove-design' %}
{% if section.settings.layout == 'quotes' %}<script src="{{ 'facelove-reviews.js' | asset_url }}" type="module"></script>{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
<section
  class="facelove-editorial color-custom-{{ section.id }}"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  style="--facelove-section-space: {{ section.settings.spacing }}px;"
>
  <div class="facelove-editorial__inner facelove-editorial__inner--{{ section.settings.layout }}">
    {% if section.settings.layout == 'image' and section.settings.image != blank %}
      <figure class="facelove-editorial__figure">
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200, 1400', sizes: '(min-width: 1320px) 580px, (min-width: 750px) calc(47vw - 40px), calc(100vw - 40px)' }}
        {% if section.settings.caption != blank %}<figcaption>{{ section.settings.caption | escape }}</figcaption>{% endif %}
      </figure>
    {% endif %}
    <div class="facelove-editorial__intro">
      {% if section.settings.eyebrow != blank %}<p class="facelove-editorial__eyebrow">{% if section.settings.layout == 'quotes' %}<span class="facelove-editorial__rating-icon" aria-hidden="true">★</span> {% endif %}{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.layout == 'image' %}
        <div class="facelove-editorial__points">
          {% for block in section.blocks %}
            <div class="facelove-editorial__point" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
              {{ block.settings.text }}
            </div>
          {% endfor %}
        </div>
      {% endif %}
      {% if section.settings.link != blank and section.settings.link_label != blank %}
        <a class="facelove-editorial__link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {% endif %}
    </div>
    {% unless section.settings.layout == 'image' %}
      {% if section.settings.layout == 'quotes' %}<facelove-reviews class="facelove-editorial__reviews">{% endif %}
      <div class="facelove-editorial__content"{% if section.settings.layout == 'quotes' %} ref="track" tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}"{% endif %}>
        {% for block in section.blocks %}
          {% case section.settings.layout %}
            {% when 'questions' %}
              {% if block.settings.heading != blank %}
                <details class="facelove-editorial__question" {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.heading | escape }}<span aria-hidden="true">+</span></summary>
                  <div class="rte">
                    {% if block.settings.product_field == 'ingredients' %}
                      {{ block.settings.text }}
                      {{ product.metafields.facelove.ingredients | metafield_tag }}
                    {% elsif block.settings.product_field == 'application' %}
                      {{ product.metafields.facelove.how_to_use | metafield_tag }}
                    {% else %}
                      {{ block.settings.text }}
                    {% endif %}
                  </div>
                </details>
              {% endif %}
            {% when 'quotes' %}
              {% if block.settings.text != blank %}
                <figure class="facelove-editorial__quote" {{ block.shopify_attributes }}>
                  <p class="facelove-editorial__stars" role="img" aria-label="{{ 'facelove.five_stars' | t }}">★★★★★</p>
                  <blockquote>{{ block.settings.text }}</blockquote>
                  <figcaption>
                    {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: '' }}{% endif %}
                    <span><strong>{{ block.settings.heading | escape }}</strong>{% if block.settings.badge != blank %}<span class="facelove-editorial__review-badge">{{ block.settings.badge | escape }}</span>{% endif %}</span>
                  </figcaption>
                </figure>
              {% endif %}
            {% else %}
              <div class="facelove-editorial__step" {{ block.shopify_attributes }}>
                <span class="facelove-editorial__number" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <div>{% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}{{ block.settings.text }}</div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
      {% if section.settings.layout == 'quotes' %}
        <div class="facelove-editorial__review-controls">
          <button type="button" ref="previous" on:click="/previous" aria-label="{{ 'facelove.previous_review' | t }}">{{ 'icon-arrow.svg' | inline_asset_content }}</button>
          <button type="button" ref="next" on:click="/next" aria-label="{{ 'facelove.next_review' | t }}">{{ 'icon-arrow.svg' | inline_asset_content }}</button>
        </div>
      </facelove-reviews>{% endif %}
    {% endunless %}
  </div>
</section>

{% stylesheet %}
  .facelove-editorial { padding-block: var(--facelove-section-space); color: var(--color-foreground); background: var(--color-background); scroll-margin-block-start: 100px; }
  .facelove-editorial__inner { width: min(var(--fl-container), calc(100% - 2 * var(--fl-gutter))); margin-inline: auto; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: var(--fl-space-4xl); }
  .facelove-editorial__inner--image { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
  .facelove-editorial__intro, .facelove-editorial__content { min-width: 0; }
  .facelove-editorial__eyebrow { font-size: 0.875rem; font-weight: 600; margin-block: 0 var(--fl-space-md); }
  .facelove-editorial h2 { font-size: var(--fl-section-title); line-height: 1.15; letter-spacing: -0.025em; font-weight: 700; margin-block: 0 var(--fl-space-xl); max-width: 19ch; }
  .facelove-editorial h3 { font-size: 1.125rem; line-height: 1.4; font-weight: 600; margin-block: 0 var(--fl-space-sm); }
  .facelove-editorial p { margin-block: 0 var(--fl-space-lg); }
  .facelove-editorial__figure { margin: 0; }
  .facelove-editorial__figure img { display: block; width: 100%; height: auto; border-radius: var(--fl-radius-surface); }
  .facelove-editorial figcaption { font-size: 0.8125rem; margin-block-start: var(--fl-space-md); }
  .facelove-editorial__point { padding-block: var(--fl-space-lg); }
  .facelove-editorial__point p { margin: 0; }
  .facelove-editorial__link { display: inline-block; padding-block: var(--fl-space-md); text-underline-offset: 5px; }
  .facelove-editorial__step { display: flex; align-items: baseline; gap: var(--fl-space-xl); padding: var(--fl-space-xl); margin-block-end: var(--fl-space-lg); background: var(--fl-color-soft); border-radius: var(--fl-radius-control); }
  .facelove-editorial__step:last-child { margin-block-end: 0; }
  .facelove-editorial__number { font-size: 1.5rem; font-weight: 600; color: var(--fl-color-accent-ink); font-variant-numeric: tabular-nums; }
  .facelove-editorial__step p { margin: 0; }
  .facelove-editorial__question { margin-block-end: var(--fl-space-md); border: 1px solid var(--fl-color-boundary); border-radius: var(--fl-radius-control); }
  .facelove-editorial__question[open] { background: var(--fl-color-soft); }
  .facelove-editorial__question summary { cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--fl-space-xl); min-height: 64px; padding: var(--fl-space-lg) var(--fl-space-xl); font-weight: 600; list-style: none; }
  .facelove-editorial__question summary::-webkit-details-marker { display: none; }
  .facelove-editorial__question summary span { font-size: 1.5rem; flex-shrink: 0; }
  .facelove-editorial__question[open] summary span { transform: rotate(45deg); }
  .facelove-editorial__question .rte { padding: 0 var(--fl-space-xl) var(--fl-space-lg); }
  .facelove-editorial__inner--quotes { display: block; }
  .facelove-editorial__inner--quotes .facelove-editorial__intro { margin-block-end: var(--fl-space-3xl); }
  .facelove-editorial__inner--quotes h2 { max-width: 24ch; }
  .facelove-editorial__reviews { display: block; }
  .facelove-editorial__inner--quotes .facelove-editorial__content { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 48px) / 3); gap: var(--fl-space-xl); overflow-x: auto; scroll-snap-type: x mandatory; padding-block: var(--fl-space-xs) var(--fl-space-xl); scrollbar-width: thin; scrollbar-color: var(--fl-color-accent) var(--fl-color-well); }
  .facelove-editorial__quote { margin: 0; padding: var(--fl-space-2xl); background: var(--fl-color-surface); color: var(--fl-color-ink); border-radius: var(--fl-radius-surface); display: flex; flex-direction: column; scroll-snap-align: start; }
  .facelove-editorial__quote blockquote { margin: 0 0 var(--fl-space-xl); font-size: 1.125rem; line-height: 1.65; flex: 1; }
  .facelove-editorial__quote figcaption { display: flex; align-items: center; gap: var(--fl-space-lg); font-size: 0.875rem; }
  .facelove-editorial__quote figcaption img { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; }
  .facelove-editorial__review-badge { display: block; width: fit-content; margin-block-start: var(--fl-space-sm); font-size: 0.6875rem; font-weight: 600; color: var(--fl-color-success); background: var(--fl-color-success-soft); border-radius: var(--fl-radius-pill); padding: var(--fl-space-xs) var(--fl-space-sm); }
  .facelove-editorial__stars { color: var(--fl-color-rating); font-size: 2rem; line-height: 1.2; }
  .facelove-editorial__rating-icon { color: var(--fl-color-rating); font-size: 1.5rem; vertical-align: middle; }
  .facelove-editorial__review-controls { display: none; justify-content: end; gap: var(--fl-space-sm); margin-block-start: var(--fl-space-lg); }
  facelove-reviews[data-ready='true'][data-scrollable='true'] .facelove-editorial__review-controls { display: flex; }
  .facelove-editorial__review-controls button { display: grid; place-items: center; width: 48px; height: 48px; background: var(--fl-color-surface); color: var(--fl-color-accent-ink); border: 1px solid var(--fl-color-boundary); border-radius: 50%; cursor: pointer; }
  .facelove-editorial__review-controls button:disabled { opacity: 0.45; cursor: not-allowed; background: transparent; }
  .facelove-editorial__review-controls button:not(:disabled):active { background: var(--fl-color-well); }
  .facelove-editorial__review-controls svg { width: 24px; height: 24px; }
  .facelove-editorial__review-controls button:first-child svg { transform: rotate(180deg); }
  [dir='rtl'] .facelove-editorial__review-controls svg { transform: rotate(180deg); }
  [dir='rtl'] .facelove-editorial__review-controls button:first-child svg { transform: none; }
  .facelove-editorial__content:focus-visible { outline: 2px solid var(--fl-color-accent); outline-offset: 4px; }
  @media (prefers-reduced-motion: no-preference) { .facelove-editorial__question summary span { transition: transform var(--fl-duration-fast) var(--fl-ease); } }
  @media (hover: hover) { .facelove-editorial__question summary:hover { color: var(--fl-color-accent-ink); } }
  @media (max-width: 749px) {
    .facelove-editorial { padding-block: min(var(--facelove-section-space), var(--fl-space-3xl)); }
    .facelove-editorial__inner { grid-template-columns: 1fr; gap: var(--fl-space-2xl); }
    .facelove-editorial__inner--image .facelove-editorial__intro { order: -1; }
    .facelove-editorial__inner--quotes .facelove-editorial__content { grid-auto-columns: 90%; gap: var(--fl-space-lg); }
    .facelove-editorial__quote { padding: var(--fl-space-xl); }
    .facelove-editorial__step { padding: var(--fl-space-lg); gap: var(--fl-space-lg); }
    .facelove-editorial__question summary { padding-inline: var(--fl-space-lg); font-size: 0.9375rem; }
    .facelove-editorial__question .rte { padding-inline: var(--fl-space-lg); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.facelove_editorial",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "select", "id": "layout", "label": "t:settings.layout", "options": [{"value":"image","label":"t:options.facelove_image"},{"value":"steps","label":"t:options.facelove_steps"},{"value":"quotes","label":"t:options.facelove_quotes"},{"value":"questions","label":"t:options.facelove_questions"}], "default":"image" },
    { "type": "text", "id": "eyebrow", "label": "t:settings.facelove_eyebrow" },
    { "type": "text", "id": "heading", "label": "t:settings.heading" },
    { "type": "richtext", "id": "text", "label": "t:settings.text" },
    { "type": "image_picker", "id": "image", "label": "t:settings.image", "visible_if": "{{ section.settings.layout == 'image' }}" },
    { "type": "text", "id": "caption", "label": "t:settings.facelove_caption", "visible_if": "{{ section.settings.layout == 'image' }}" },
    { "type": "url", "id": "link", "label": "t:settings.link" },
    { "type": "text", "id": "link_label", "label": "t:settings.facelove_link_label" },
    { "type": "text", "id": "anchor", "label": "t:settings.facelove_anchor" },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "default": "#ffffff" },
    { "type": "range", "id": "spacing", "label": "t:settings.facelove_spacing", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [{
    "type": "content",
    "name": "t:names.facelove_content",
    "settings": [
      { "type": "text", "id": "heading", "label": "t:settings.heading" },
      { "type": "image_picker", "id": "image", "label": "t:settings.image" },
      { "type": "text", "id": "badge", "label": "t:settings.facelove_verified" },
      { "type": "richtext", "id": "text", "label": "t:settings.text" },
      { "type": "select", "id": "product_field", "label": "t:settings.facelove_product_field", "options": [{"value":"none","label":"t:options.none"},{"value":"ingredients","label":"t:options.facelove_ingredients"},{"value":"application","label":"t:options.facelove_application"}], "default":"none" }
    ]
  }],
  "presets": [{ "name":"t:names.facelove_editorial", "category":"t:categories.storytelling" }]
}
{% endschema %}
