{% comment %}
  Five source product stories become layered desktop cards; mobile and reduced-motion views retain normal document flow.
  @example
  Add image and copy blocks in the desired reading order.
{% endcomment %}
{% render 'facelove-design' %}
{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
<script src="{{ 'facelove-story.js' | asset_url }}" type="module"></script>
<facelove-story class="facelove-journey color-custom-{{ section.id }}" id="{{ section.settings.anchor | handleize }}" role="region" aria-labelledby="StoryHeading-{{ section.id }}">
  <header class="facelove-journey__heading">{% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="StoryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div></header>
  <div class="facelove-journey__chapters">
    {% for block in section.blocks %}
      <article class="facelove-journey__chapter" ref="chapters[]" id="Reason-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
        <div class="facelove-journey__card" ref="cards[]">
          <figure>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 960 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960', sizes: '(min-width: 1200px) 430px, (min-width: 960px) 38vw, calc(100vw - 88px)' }}{% endif %}{% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}</figure>
          <div class="facelove-journey__copy">
            <p class="facelove-journey__number"><span>0{{ forloop.index }}</span><span>/ 0{{ section.blocks.size }}</span></p>
            <h3>{{ block.settings.heading | escape }}</h3><div class="rte">{{ block.settings.text }}</div>
            {% if section.settings.link != blank %}<a class="button facelove-journey__chapter-cta" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</facelove-story>
{% stylesheet %}
  .facelove-journey { display: block; background: var(--color-background); color: var(--color-foreground); padding: var(--fl-space-section) 0; }
  .facelove-journey__heading, .facelove-journey__chapters { width: min(var(--fl-container), calc(100% - 2 * var(--fl-gutter))); margin-inline: auto; }
  .facelove-journey__heading { display: grid; grid-template-columns: 1.2fr 0.8fr; column-gap: var(--fl-space-4xl); align-items: end; margin-block-end: var(--fl-space-3xl); }
  .facelove-journey__heading > p { grid-column: 1 / -1; font-size: 0.875rem; font-weight: 600; margin: 0 0 var(--fl-space-md); }
  .facelove-journey h2 { font-size: var(--fl-section-title); font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; margin: 0; }
  .facelove-journey__heading .rte { max-width: 30ch; justify-self: end; }
  .facelove-journey__heading .rte p { margin: 0; }
  .facelove-journey__chapters { max-width: 1100px; }
  .facelove-journey__chapter { padding-block-end: var(--fl-space-xl); scroll-margin-block-start: 80px; }
  .facelove-journey__card { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); align-items: center; gap: var(--fl-space-2xl); padding: var(--fl-space-xl); border-radius: var(--fl-radius-surface); background: var(--fl-color-surface); color: var(--fl-color-ink); box-shadow: var(--fl-shadow-raised); border: 1px solid transparent; }
  .facelove-journey__chapter figure { margin: 0; min-width: 0; }
  .facelove-journey__chapter img { width: 100%; max-height: 320px; object-fit: contain; display: block; border-radius: var(--fl-radius-control); }
  .facelove-journey__chapter figcaption { margin-block-start: var(--fl-space-md); font-size: 0.8125rem; }
  .facelove-journey__copy { min-width: 0; }
  .facelove-journey__number { display: flex; align-items: baseline; gap: var(--fl-space-md); margin-block: 0 var(--fl-space-lg); font-variant-numeric: tabular-nums; }
  .facelove-journey__number span:first-child { font-size: 2rem; line-height: 1; font-weight: 600; color: var(--fl-color-accent-ink); }
  .facelove-journey__number span:last-child { font-size: 0.875rem; }
  .facelove-journey h3 { font-size: clamp(1.25rem, 2vw, 1.625rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; margin: 0 0 var(--fl-space-lg); max-width: 30ch; }
  .facelove-journey__copy ul { padding-inline-start: var(--fl-space-xl); font-size: 0.9375rem; line-height: 1.5; }
  .facelove-journey__copy li { padding-inline-start: var(--fl-space-xs); margin-block: var(--fl-space-sm); }
  .facelove-journey__chapter-cta { margin-block-start: var(--fl-space-sm); width: fit-content; font-size: 0.8125rem; }
  @media (min-width: 960px) and (min-height: 720px) and (prefers-reduced-motion: no-preference) {
    .facelove-journey[data-enhanced='true'] .facelove-journey__chapter { position: sticky; inset-block-start: 72px; }
    .facelove-journey[data-enhanced='true'] .facelove-journey__card { transform-origin: 50% 0; opacity: calc(1 - var(--fl-progress, 0) * 0.92); transform: perspective(1000px) translate3d(0, calc(var(--fl-enter, 0) * 24px - var(--fl-progress, 0) * 24px), calc(var(--fl-progress, 0) * -120px)) rotateX(calc(var(--fl-progress, 0) * 9deg - var(--fl-enter, 0) * 5deg)) scale(calc(1 - var(--fl-progress, 0) * 0.1 - var(--fl-enter, 0) * 0.03)); }
  }
  @media (max-width: 959px) {
    .facelove-journey { padding-block: var(--fl-space-3xl); }
    .facelove-journey__heading { display: block; margin-block-end: var(--fl-space-xl); }
    .facelove-journey__heading .rte { margin-block-start: var(--fl-space-lg); }
    .facelove-journey__card { grid-template-columns: 1fr; gap: var(--fl-space-xl); }
  }
{% endstylesheet %}
{% schema %}
{
  "name":"t:names.facelove_journey", "disabled_on":{"groups":["header","footer"]},
  "settings":[
    {"type":"text","id":"eyebrow","label":"t:settings.facelove_eyebrow"},
    {"type":"text","id":"heading","label":"t:settings.heading"},
    {"type":"richtext","id":"text","label":"t:settings.text"},
    {"type":"text","id":"anchor","label":"t:settings.facelove_anchor"},
    {"type":"url","id":"link","label":"t:settings.link"},
    {"type":"text","id":"link_label","label":"t:settings.facelove_link_label"},
    {"type":"color","id":"background_color","label":"t:settings.background_color","default":"#f5f0f8"}
  ],
  "blocks":[{"type":"chapter","name":"t:names.facelove_content","settings":[
    {"type":"text","id":"heading","label":"t:settings.heading"},
    {"type":"richtext","id":"text","label":"t:settings.text"},
    {"type":"image_picker","id":"image","label":"t:settings.image"},
    {"type":"text","id":"caption","label":"t:settings.facelove_caption"}
  ]}],
  "presets":[{"name":"t:names.facelove_journey","category":"t:categories.storytelling"}]
}
{% endschema %}
