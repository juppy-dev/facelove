{% comment %}
  Accessible text comparison with a dedicated form for the product's referenced two-stick offer.
  @example
  Add this section to the Facelove product template and edit each comparison row.
{% endcomment %}
{% render 'facelove-design' %}
{% liquid
  assign bundle = product.metafields.facelove.bundle_variant.value
  assign form_id = 'FaceloveBundleForm-' | append: section.id
%}
{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% render 'add-to-cart-button-styles' %}
{% render 'fly-to-cart-styles' %}
{% render 'buy-buttons-styles' %}
{% render 'facelove-offer-styles' %}
<section class="facelove-comparison color-custom-{{ section.id }}">
  <div class="facelove-comparison__inner">
    <div class="facelove-comparison__intro">
      <p>{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '320, 480, 720', sizes: '(min-width: 750px) 32vw, 80vw' }}{% endif %}
    </div>
    <div class="facelove-comparison__content">
      <table>
        <thead><tr><th scope="col">{{ section.settings.brand_heading | escape }}</th><th scope="col">{{ section.settings.other_heading | escape }}</th></tr></thead>
        <tbody>{% for block in section.blocks %}<tr {{ block.shopify_attributes }}><td><span aria-hidden="true">✓</span>{{ block.settings.brand_text | escape }}</td><td>{{ block.settings.other_text | escape }}</td></tr>{% endfor %}</tbody>
      </table>
      {% if bundle != blank %}
        <product-form-component data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" data-quantity-default="1" on:submit="/handleSubmit">
          <div class="visually-hidden" ref="liveRegion" aria-live="assertive" role="status" aria-atomic="true"></div>
          {% form 'product', product, id: form_id, data-type: 'add-to-cart-form' %}
            <input type="hidden" name="id" ref="variantId" value="{{ bundle.id }}">
            <input type="hidden" name="quantity" value="1">
            <div ref="productFormButtons">
              <span ref="addToCartTextError" class="product-form-text__error hidden"></span>
              {% capture button_text %}{{ section.settings.button_label | escape }} <span class="facelove-button-price"><strong>{{ bundle.price | money_without_trailing_zeros }}</strong>{% if bundle.compare_at_price > bundle.price %}<s>{{ bundle.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}</span>{% endcapture %}
              {% unless bundle.available %}{% assign button_text = 'products.product.sold_out' | t %}{% endunless %}
              {% render 'add-to-cart-button', product: product, can_add_to_cart: bundle.available, add_to_cart_text: button_text, show_icon: false, class: 'facelove-comparison__button add-to-cart-button' %}
            </div>
          {% endform %}
        </product-form-component>
        <p class="facelove-comparison__freebies">{{ section.settings.freebies | escape }}</p>
      {% endif %}
    </div>
  </div>
</section>
{% stylesheet %}
  .facelove-comparison { color: var(--color-foreground); background: var(--color-background); padding-block: var(--fl-space-section); }
  .facelove-comparison__inner { width: min(var(--fl-container), calc(100% - 2 * var(--fl-gutter))); margin: auto; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: var(--fl-space-4xl); align-items: center; }
  .facelove-comparison__intro > p { font-size: 0.875rem; font-weight: 600; margin-block: 0 var(--fl-space-lg); }
  .facelove-comparison h2 { font-size: var(--fl-section-title); font-weight: 700; line-height: 1.15; letter-spacing: -0.025em; margin: 0 0 var(--fl-space-xl); }
  .facelove-comparison__intro img { display: block; width: 100%; max-height: 300px; object-fit: contain; margin-block-start: var(--fl-space-xl); }
  .facelove-comparison__content { min-width: 0; }
  .facelove-comparison table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; font-size: 0.9375rem; line-height: 1.5; border-radius: var(--fl-radius-surface); box-shadow: var(--fl-shadow-soft); }
  .facelove-comparison th { padding: var(--fl-space-xl); font-size: 1.25rem; font-weight: 700; text-align: start; }
  .facelove-comparison th:first-child { background: var(--fl-color-accent-ink); color: var(--fl-color-on-accent); border-start-start-radius: var(--fl-radius-surface); }
  .facelove-comparison th:last-child { background: var(--fl-color-well); color: var(--fl-color-ink); border-start-end-radius: var(--fl-radius-surface); }
  .facelove-comparison td { vertical-align: top; padding: var(--fl-space-lg) var(--fl-space-xl); }
  .facelove-comparison td:first-child { background: var(--fl-color-well); color: var(--fl-color-accent-ink); font-weight: 600; }
  .facelove-comparison td:first-child span { display: inline-block; margin-inline-end: var(--fl-space-sm); color: var(--fl-color-accent); font-weight: 700; }
  .facelove-comparison td:last-child { background: var(--fl-color-soft); color: var(--fl-color-muted); }
  .facelove-comparison tr:last-child td { padding-block-end: var(--fl-space-xl); }
  .facelove-comparison tr:last-child td:first-child { border-end-start-radius: var(--fl-radius-surface); }
  .facelove-comparison tr:last-child td:last-child { border-end-end-radius: var(--fl-radius-surface); }
  .facelove-comparison__button { width: 100%; min-height: 56px; margin-block-start: var(--fl-space-xl); border-radius: var(--fl-radius-control); font-family: var(--fl-font); font-size: 1rem; font-weight: 600; box-shadow: var(--fl-shadow-raised); }
  .facelove-comparison__freebies { text-align: center; font-size: 0.8125rem; line-height: 1.5; margin: var(--fl-space-md) auto 0; max-width: 52ch; }
  @media (max-width: 749px) {
    .facelove-comparison { padding-block: var(--fl-space-3xl); }
    .facelove-comparison__inner { grid-template-columns: 1fr; gap: var(--fl-space-2xl); }
    .facelove-comparison__intro img { max-height: 220px; }
    .facelove-comparison th, .facelove-comparison td { padding: var(--fl-space-lg) var(--fl-space-md); }
    .facelove-comparison table { font-size: 0.8125rem; }
    .facelove-comparison th { font-size: 1rem; }
    .facelove-comparison__button { font-size: 0.8125rem; }
  }
{% endstylesheet %}
{% schema %}
{
  "name":"t:names.facelove_comparison", "disabled_on":{"groups":["header","footer"]},
  "settings":[
    {"type":"text","id":"eyebrow","label":"t:settings.facelove_eyebrow"},
    {"type":"text","id":"heading","label":"t:settings.heading"},
    {"type":"richtext","id":"text","label":"t:settings.text"},
    {"type":"image_picker","id":"image","label":"t:settings.image"},
    {"type":"text","id":"brand_heading","label":"t:settings.facelove_brand_heading"},
    {"type":"text","id":"other_heading","label":"t:settings.facelove_other_heading"},
    {"type":"text","id":"button_label","label":"t:settings.facelove_link_label"},
    {"type":"text","id":"freebies","label":"t:settings.facelove_freebies"},
    {"type":"color","id":"background_color","label":"t:settings.background_color","default":"#ffffff"}
  ],
  "blocks":[{"type":"row","name":"t:names.facelove_comparison_row","settings":[
    {"type":"text","id":"brand_text","label":"t:settings.facelove_brand_heading"},
    {"type":"text","id":"other_text","label":"t:settings.facelove_other_heading"}
  ]}],
  "presets":[{"name":"t:names.facelove_comparison","category":"t:categories.storytelling"}]
}
{% endschema %}
