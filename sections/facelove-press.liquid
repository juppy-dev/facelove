{% comment %}
  Source press placements retain their sponsored-content qualifier.
  @example
  Select the original publication logos in merchant-controlled blocks.
{% endcomment %}
{% render 'facelove-design' %}
<section class="facelove-press">
  <div class="facelove-press__label"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.qualifier | escape }}</p></div>
  <div class="facelove-press__logos">{% for block in section.blocks %}{% if block.settings.image != blank %}<div {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180, 360', sizes: '(min-width: 750px) 160px, 100px', alt: block.settings.name }}</div>{% endif %}{% endfor %}</div>
</section>
{% stylesheet %}
  .facelove-press { width: min(var(--fl-container), calc(100% - 2 * var(--fl-gutter))); margin: auto; padding: var(--fl-space-2xl); display: flex; align-items: center; gap: var(--fl-space-3xl); background: var(--fl-color-soft); color: var(--fl-color-ink); border-radius: var(--fl-radius-surface); }
  .facelove-press__label { flex-shrink: 0; }
  .facelove-press h2 { font: 600 1rem/1.4 var(--fl-font); margin: 0 0 var(--fl-space-xs); }
  .facelove-press p { font-size: 0.75rem; margin: 0; color: var(--fl-color-muted); }
  .facelove-press__logos { display: flex; align-items: center; justify-content: space-between; flex: 1; gap: var(--fl-space-2xl); min-width: 0; }
  .facelove-press__logos > div { min-width: 0; }
  .facelove-press img { width: 160px; height: 36px; object-fit: contain; }
  @media (max-width: 749px) {
    .facelove-press { display: block; text-align: center; padding: var(--fl-space-xl) var(--fl-space-lg); }
    .facelove-press__logos { flex-wrap: wrap; justify-content: center; gap: var(--fl-space-lg) var(--fl-space-xl); margin-block-start: var(--fl-space-xl); }
    .facelove-press img { width: 100px; height: 28px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name":"t:names.facelove_press", "disabled_on":{"groups":["header","footer"]},
  "settings":[{"type":"text","id":"heading","label":"t:settings.heading"},{"type":"text","id":"qualifier","label":"t:settings.facelove_caption"}],
  "blocks":[{"type":"publication","name":"t:names.facelove_publication","settings":[{"type":"text","id":"name","label":"t:settings.heading"},{"type":"image_picker","id":"image","label":"t:settings.image"}]}],
  "presets":[{"name":"t:names.facelove_press","category":"t:categories.storytelling"}]
}
{% endschema %}
