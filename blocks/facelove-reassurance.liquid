{% doc %}
  A compact money-back promise next to the product form.
  @example
  {% content_for 'block', type: 'facelove-reassurance', id: 'guarantee' %}
{% enddoc %}
<div class="facelove-reassurance" {{ block.shopify_attributes }}>
  <span class="facelove-reassurance__icon">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 72 | image_tag: loading: 'lazy', widths: '36, 72', sizes: '36px', alt: '' }}{% else %}{% render 'facelove-icon', name: 'shield' %}{% endif %}</span>
  <div><h2>{{ block.settings.heading | escape }}</h2><div class="rte">{{ block.settings.text }}</div></div>
</div>
{% stylesheet %}
  .facelove-reassurance { display: flex; align-items: start; gap: var(--fl-space-sm); padding: 6px var(--fl-space-md); background: var(--fl-color-well); border: 1px solid var(--fl-color-boundary); border-radius: var(--fl-radius-control); width: 100%; }
  .facelove-reassurance__icon { flex: 0 0 24px; width: 24px; height: 24px; color: var(--fl-color-accent-ink); }
  .facelove-reassurance h2 { font: 600 0.875rem/1.3 var(--font-body--family); margin: 0 0 2px; }
  .facelove-reassurance .rte { font-size: 0.8125rem; line-height: 1.4; }
  .facelove-reassurance p { margin: 0; }
{% endstylesheet %}
{% schema %}
{
  "name":"t:names.facelove_reassurance", "tag":null,
  "settings":[
    {"type":"text","id":"heading","label":"t:settings.heading"},
    {"type":"richtext","id":"text","label":"t:settings.text"},
    {"type":"image_picker","id":"image","label":"t:settings.image"}
  ],
  "presets":[{"name":"t:names.facelove_reassurance","category":"t:categories.product"}]
}
{% endschema %}
