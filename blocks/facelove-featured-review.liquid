{% doc %}
  A source review placed beneath the gallery on desktop and product details on mobile.
  @example
  {% content_for 'block', type: 'facelove-featured-review', id: 'featured-review' %}
{% enddoc %}
<figure class="facelove-featured-review" {{ block.shopify_attributes }}>
  <div class="facelove-featured-review__rating"><span role="img" aria-label="{{ 'facelove.five_stars' | t }}">★★★★★</span><span>{{ block.settings.verified_label | escape }}</span></div>
  <blockquote>{{ block.settings.quote }}</blockquote>
  <figcaption>
    {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 112 | image_tag: loading: 'lazy', widths: '56, 112', sizes: '56px' }}{% endif %}
    <strong>{{ block.settings.author | escape }}</strong>
    {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}
  </figcaption>
  <div class="facelove-featured-review__confidence"><span>{% render 'facelove-icon', name: 'shield' %}{{ block.settings.confidence_label | escape }}</span><span>{{ block.settings.shipping_label | escape }}</span></div>
</figure>
{% stylesheet %}
  .facelove-featured-review { order: 2; align-self: start; margin: var(--fl-space-xl) 0 0; padding: var(--fl-space-2xl); background: var(--fl-color-soft); border: 1px solid transparent; box-shadow: var(--fl-shadow-soft); border-radius: var(--fl-radius-surface); font-size: 1rem; }
  .facelove-featured-review__rating { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 0.75rem; }
  .facelove-featured-review__rating > :first-child { color: var(--fl-color-rating); letter-spacing: 0; font-size: 1.625rem; }
  .facelove-featured-review__rating > :last-child { color: var(--fl-color-success); background: var(--fl-color-success-soft); padding: var(--fl-space-xs) var(--fl-space-sm); border-radius: var(--fl-radius-pill); font-weight: 600; }
  .facelove-featured-review blockquote { margin: 16px 0; font-size: clamp(1rem, 1.5vw, 1.25rem); line-height: 1.5; }
  .facelove-featured-review blockquote p { margin: 0; }
  .facelove-featured-review figcaption { display: flex; align-items: center; gap: 12px; font-size: 0.875rem; }
  .facelove-featured-review figcaption a { margin-inline-start: auto; font-size: 0.8125rem; text-underline-offset: 4px; padding-block: var(--fl-space-md); }
  .facelove-featured-review__confidence { display: flex; flex-wrap: wrap; align-items: center; gap: var(--fl-space-md); margin-block-start: var(--fl-space-lg); color: var(--fl-color-accent-ink); font-size: 0.75rem; font-weight: 600; }
  .facelove-featured-review__confidence > span { display: flex; align-items: center; gap: var(--fl-space-xs); }
  .facelove-featured-review__confidence svg { width: 20px; height: 20px; }
  .facelove-featured-review img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; }
  @media (min-width: 750px) {
    .product-information__grid:has(> .facelove-featured-review) { grid-template-rows: auto 1fr; }
    .product-information__grid:has(> .facelove-featured-review) > .product-information__media { grid-row: 1; align-self: start; }
    .product-information__grid:has(> .facelove-featured-review) > .product-details { grid-row: 1 / span 2; }
    .product-information__grid > .facelove-featured-review { grid-column: 1; grid-row: 2; margin-inline-end: calc(var(--gap) / 2); }
    .product-information__grid--half > .facelove-featured-review { grid-column: 2; }
    .product-information--media-right > .facelove-featured-review { grid-column: 2; margin-inline: calc(var(--gap) / 2) 0; }
    .product-information--media-right.product-information__grid--half > .facelove-featured-review { grid-column: 3; }
  }
  @media (max-width: 749px) { .product-information__grid > .facelove-featured-review { grid-column: 2; margin-block-start: var(--fl-space-2xl); padding: var(--fl-space-xl); } }
{% endstylesheet %}
{% schema %}
{
  "name": "t:names.facelove_featured_review", "tag": null,
  "settings": [
    {"type":"text","id":"confidence_label","label":"t:settings.facelove_guarantee_label"},
    {"type":"text","id":"shipping_label","label":"t:settings.facelove_shipping_label"},
    {"type":"url","id":"link","label":"t:settings.link"},
    {"type":"text","id":"link_label","label":"t:settings.facelove_link_label"},
    {"type":"richtext","id":"quote","label":"t:settings.text"},
    {"type":"text","id":"author","label":"t:settings.facelove_author"},
    {"type":"text","id":"verified_label","label":"t:settings.facelove_verified"},
    {"type":"image_picker","id":"image","label":"t:settings.image"}
  ]
}
{% endschema %}
