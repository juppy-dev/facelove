{% doc %}
  Shows product-owned shade guidance and a brief benefit list beside the native purchase form.
  @example
  {% content_for 'block', type: 'facelove-summary', id: 'product-summary', closest.product: product %}
{% enddoc %}

{% liquid
  assign product_resource = closest.product
  assign color_id = 'facelove-' | append: block.id
%}
{% render 'contrast-override', background_color: block.settings.background_color, section_id: color_id %}
<div class="facelove-summary"{% if block.settings.anchor != blank %} id="{{ block.settings.anchor | handleize }}"{% endif %} {{ block.shopify_attributes }}>
  <ul class="facelove-summary__promises">
    {% for index in (1..3) %}
      {% liquid
        assign image_key = 'image_' | append: index
        assign text_key = 'text_' | append: index
      %}
      {% if block.settings[text_key] != blank %}
        <li>{% if block.settings[image_key] != blank %}{{ block.settings[image_key] | image_url: width: 80 | image_tag: widths: '40, 80', sizes: '36px', alt: '' }}{% endif %}<span>{{ block.settings[text_key] | escape }}</span></li>
      {% endif %}
    {% endfor %}
  </ul>
  {% if product_resource.metafields.facelove.shade_guidance != blank %}
    <p class="facelove-summary__shade color-custom-{{ color_id }}">
      {{ product_resource.metafields.facelove.shade_guidance.value | escape }}
    </p>
  {% endif %}
  {% if block.settings.show_benefits and product_resource.metafields.facelove.benefits.value.size > 0 %}
    <ul class="facelove-summary__benefits">
      {% for benefit in product_resource.metafields.facelove.benefits.value limit: 3 %}
        <li>{{ benefit | escape }}</li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% stylesheet %}
  .facelove-summary { width: 100%; scroll-margin-block-start: 110px; }
  .facelove-summary__shade { margin: 14px 0 0; padding: 10px 14px; font-size: 0.8125rem; line-height: 1.5; }
  .facelove-summary__promises { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .facelove-summary__promises li { display: flex; align-items: center; gap: 12px; font-size: 1rem; }
  .facelove-summary__promises img { width: 36px; height: 36px; flex: 0 0 36px; }
  .facelove-summary__benefits { padding-inline-start: 20px; margin-block: 16px 0; line-height: 1.6; }
  .facelove-summary__benefits li { padding-inline-start: 4px; }
  .product-information:has(.facelove-summary) {
    --style-border-radius-buttons-primary: 4px;
    --style-border-radius-buttons-secondary: 4px;
    font-size: 16px;
  }
  .product-information:has(.facelove-summary) h1 { font-size: clamp(2rem, 3.1vw, 2.8rem); font-weight: 500; line-height: 1.12; letter-spacing: -0.025em; }
  .product-information:has(.facelove-summary) .price { font-size: 2rem; font-weight: 650; color: #513865; }
  .product-information:has(.facelove-summary) .compare-at-price { font-size: 1.125rem; opacity: 1; color: #706977; }
  .product-information:has(.facelove-summary) [ref='priceContainer'] { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .product-information:has(.facelove-summary) .variant-option--buttons { display: grid; grid-template-columns: 1fr; gap: 8px; }
  .product-information:has(.facelove-summary) .variant-option__button-label { justify-content: space-between; gap: 12px; min-height: 88px; min-width: 0; width: 100%; padding: 14px 16px; border-radius: 6px; white-space: normal; border-width: 2px; }
  .product-information:has(.facelove-summary) .variant-option__button-label__pill { display: none; }
  .product-information:has(.facelove-summary) .variant-option__button-label:has(:checked) { background-color: var(--color-selected-variant-background); }
  .product-information:has(.facelove-summary) .variant-option__button-label__text { flex: 1; font-weight: 600; }
  .product-information:has(.facelove-summary) .variant-option__offer-price { display: grid; grid-template-columns: auto auto; align-items: center; justify-content: end; gap: 5px 8px; }
  .product-information:has(.facelove-summary) .variant-option__offer-price strong { font-size: 1.25rem; }
  .product-information:has(.facelove-summary) .variant-option__offer-price s { font-size: 0.875rem; color: #706977; }
  .variant-option__offer-price .facelove-saving { grid-column: 1 / -1; justify-self: end; }
  .product-information:has(.facelove-summary) .variant-option__button-label__text { text-align: start; }
  .product-information:has(.facelove-summary) .variant-option__button-label:has(:focus-visible) { outline: 2px solid currentColor; outline-offset: 4px; }
  .product-information:has(.facelove-summary) .product-form-buttons .add-to-cart-button { min-height: 54px; font-size: 1rem; }
  .shopify-section:has(.facelove-summary) .sticky-add-to-cart__bar { width: min(760px, calc(100% - 32px)); }
  .shopify-section:has(.facelove-summary) .sticky-add-to-cart__price [ref='priceContainer'] { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }
  .shopify-section:has(.facelove-summary) .sticky-add-to-cart__price .price { color: #513865; font-weight: 650; font-size: 1.25rem; }
  .shopify-section:has(.facelove-summary) .sticky-add-to-cart__price .compare-at-price { color: #706977; opacity: 1; }
  @media screen and (max-width: 749px) {
    .product-information:has(.facelove-summary) .product-details > .group-block { padding-block-start: 20px; }
    .product-information:has(.facelove-summary) .product-media-container { max-height: 360px; }
    .product-information:has(.facelove-summary) .facelove-summary__benefits { font-size: 0.875rem; }
    .shopify-section:has(.facelove-summary) .sticky-add-to-cart__info { display: none; }
    .shopify-section:has(.facelove-summary) .sticky-add-to-cart__image { display: none; }
    .shopify-section:has(.facelove-summary) .sticky-add-to-cart__price { flex: 1; }
    .shopify-section:has(.facelove-summary) .sticky-add-to-cart__bar { gap: 12px; }
    .shopify-section:has(.facelove-summary) .sticky-add-to-cart__price .facelove-saving { font-size: 0.75rem; padding: 4px 6px; }
    .shopify-section:has(.facelove-summary) .sticky-add-to-cart__button { width: auto; padding-inline: 16px; }
    .shopify-section:has(.facelove-summary) .sticky-add-to-cart__button .add-to-cart-text__content { display: inline; }
    .shopify-section:has(.facelove-summary) .sticky-add-to-cart__button .add-to-cart-text > .svg-wrapper { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.facelove_summary",
  "tag": null,
  "settings": [
    { "type": "text", "id": "anchor", "label": "t:settings.facelove_anchor" },
    { "type": "checkbox", "id": "show_benefits", "label": "t:settings.facelove_show_benefits", "default": false },
    { "type": "image_picker", "id": "image_1", "label": "t:settings.image" },
    { "type": "text", "id": "text_1", "label": "t:settings.text" },
    { "type": "image_picker", "id": "image_2", "label": "t:settings.image" },
    { "type": "text", "id": "text_2", "label": "t:settings.text" },
    { "type": "image_picker", "id": "image_3", "label": "t:settings.image" },
    { "type": "text", "id": "text_3", "label": "t:settings.text" },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "default": "#eee7f5" }
  ],
  "presets": [{ "name": "t:names.facelove_summary", "category": "t:categories.product" }]
}
{% endschema %}
