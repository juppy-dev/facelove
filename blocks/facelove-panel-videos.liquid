{% doc %}
  Compact video proof within the purchase panel, using the existing manual video and carousel components.
  @example
  Add this block beneath the offer and choose three Shopify Files videos.
{% enddoc %}
<script src="{{ 'facelove-video.js' | asset_url }}" type="module"></script>
<script src="{{ 'facelove-reviews.js' | asset_url }}" type="module"></script>
<facelove-reviews class="facelove-panel-videos" {{ block.shopify_attributes }}>
  <header><h2>{{ block.settings.heading | escape }}</h2><div class="facelove-panel-videos__controls"><button type="button" ref="previous" on:click="/previous" aria-label="{{ 'facelove.previous_videos' | t }}">←</button><button type="button" ref="next" on:click="/next" aria-label="{{ 'facelove.next_videos' | t }}">→</button></div></header>
  <div class="facelove-panel-videos__track" ref="track" tabindex="0" role="region" aria-label="{{ block.settings.heading | escape }}">
    {% for index in (1..3) %}
      {% liquid
        assign video_key = 'video_' | append: index
        assign name_key = 'name_' | append: index
        assign age_key = 'age_' | append: index
        assign clip = block.settings[video_key]
        assign play_label = 'facelove.play_video' | t: name: block.settings[name_key]
        assign pause_label = 'facelove.pause_video' | t: name: block.settings[name_key]
      %}
      {% if clip != blank %}
        <facelove-video class="facelove-panel-videos__card" data-play-label="{{ play_label | escape }}" data-pause-label="{{ pause_label | escape }}" data-error-label="{{ 'facelove.video_error' | t | escape }}">
          {{ clip | video_tag: image_size: '360x', autoplay: false, loop: true, muted: true, controls: true, preload: 'none', loading: 'lazy', ref: 'video' }}
          {% if block.settings.demo_mode %}<span class="facelove-panel-videos__demo">{{ 'facelove.demo_clip' | t }}</span>{% endif %}
          <button class="facelove-panel-videos__play" type="button" ref="toggle" on:click="/togglePlayback" aria-label="{{ play_label | escape }}" aria-pressed="false" hidden><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path class="facelove-panel-videos__play-icon" d="m8 5 11 7-11 7Z"/><path class="facelove-panel-videos__pause-icon" d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg></button>
          <div class="facelove-panel-videos__profile"><strong>{{ block.settings[name_key] | escape }}, {{ block.settings[age_key] | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#1877f2"/><path d="m7 12 3.2 3.2L17 8.5" fill="none" stroke="white" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg></strong><span>{{ 'facelove.verified_buyer' | t }}</span><small>{{ closest.product.title | escape }}</small></div>
          <p class="facelove-panel-videos__status" ref="status" role="status"></p>
        </facelove-video>
      {% endif %}
    {% endfor %}
  </div>
</facelove-reviews>
{% stylesheet %}
  .facelove-panel-videos { display: block; width: 100%; min-width: 0; margin-block-start: var(--fl-space-sm); }
  .facelove-panel-videos header { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-block-end: 6px; }
  .facelove-panel-videos h2 { font-size: 1rem; font-weight: 600; margin: 0; }
  .facelove-panel-videos__controls { display: flex; gap: 2px; }
  .facelove-panel-videos__controls button { width: 44px; height: 44px; padding: 0; border: 0; background: transparent; color: var(--fl-color-ink); font-size: 1.25rem; cursor: pointer; }
  .facelove-panel-videos__controls button:disabled { opacity: 0.3; cursor: default; }
  .facelove-panel-videos__track { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(126px, 32%, 150px); gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; padding-block-end: 4px; }
  .facelove-panel-videos__card { display: block; position: relative; min-width: 0; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 10px; background: var(--fl-color-well); scroll-snap-align: start; }
  .facelove-panel-videos__card video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .facelove-panel-videos__demo { position: absolute; inset-block-start: 6px; inset-inline-start: 6px; padding: 2px 5px; border-radius: 3px; background: rgb(21 18 24 / 0.8); color: white; font-size: 0.5625rem; }
  .facelove-panel-videos__play { position: absolute; inset-block-start: 32%; inset-inline-start: calc(50% - 22px); display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid rgb(255 255 255 / 0.8); border-radius: 50%; background: rgb(21 18 24 / 0.55); color: white; cursor: pointer; }
  .facelove-panel-videos__play[hidden] { display: none; }
  .facelove-panel-videos__play svg { width: 23px; height: 23px; }
  .facelove-panel-videos__pause-icon, [data-playing='true'] .facelove-panel-videos__play-icon { display: none; }
  [data-playing='true'] .facelove-panel-videos__pause-icon { display: block; }
  .facelove-panel-videos__profile { position: absolute; inset-inline: 0; inset-block-end: 0; padding: 24px 8px 8px; background: linear-gradient(transparent, rgb(21 18 24 / 0.9) 35%); color: white; pointer-events: none; line-height: 1.3; }
  .facelove-panel-videos__profile strong { display: flex; align-items: center; gap: 3px; font-size: 0.8125rem; }
  .facelove-panel-videos__profile svg { width: 15px; height: 15px; }
  .facelove-panel-videos__profile span, .facelove-panel-videos__profile small { display: block; font-size: 0.5625rem; margin-block-start: 2px; }
  .facelove-panel-videos__profile small { margin-block-start: 8px; }
  .facelove-panel-videos__status:not(:empty) { position: absolute; inset: auto 4px 4px; z-index: 2; margin: 0; padding: 6px; background: white; color: var(--fl-color-ink); font-size: 0.6875rem; }
{% endstylesheet %}
{% schema %}
{
  "name":"t:names.facelove_panel_videos", "tag":null,
  "settings":[
    {"type":"text","id":"heading","label":"t:settings.heading"},
    {"type":"checkbox","id":"demo_mode","label":"t:settings.facelove_demo_mode","default":true},
    {"type":"video","id":"video_1","label":"t:settings.video"},
    {"type":"text","id":"name_1","label":"t:settings.facelove_profile_name"},
    {"type":"text","id":"age_1","label":"t:settings.facelove_profile_age"},
    {"type":"video","id":"video_2","label":"t:settings.video"},
    {"type":"text","id":"name_2","label":"t:settings.facelove_profile_name"},
    {"type":"text","id":"age_2","label":"t:settings.facelove_profile_age"},
    {"type":"video","id":"video_3","label":"t:settings.video"},
    {"type":"text","id":"name_3","label":"t:settings.facelove_profile_name"},
    {"type":"text","id":"age_3","label":"t:settings.facelove_profile_age"}
  ],
  "presets":[{"name":"t:names.facelove_panel_videos","category":"t:categories.product"}]
}
{% endschema %}
