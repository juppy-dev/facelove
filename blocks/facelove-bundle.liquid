{% doc %}
  Gift eligibility follows the product's bundle variant reference; promotion copy is merchant-owned.
  @example
  {% content_for 'block', type: 'facelove-bundle', id: 'bundle-benefits', closest.product: product %}
{% enddoc %}
{% liquid
  assign bundle = closest.product.metafields.facelove.bundle_variant.value
  assign unlocked = false
  if closest.product.selected_or_first_available_variant.id == bundle.id
    assign unlocked = true
  endif
%}
<script src="{{ 'facelove-bundle.js' | asset_url }}" type="module"></script>
<facelove-bundle class="facelove-bundle" data-bundle-id="{{ bundle.id }}" data-unlocked="{{ unlocked }}" data-locked-label="{{ block.settings.locked_heading | escape }}" data-unlocked-label="{{ block.settings.unlocked_heading | escape }}" {{ block.shopify_attributes }}>
  <p class="visually-hidden" ref="status" role="status" aria-live="polite" aria-atomic="true">{% if unlocked %}{{ block.settings.unlocked_heading | escape }}{% else %}{{ block.settings.locked_heading | escape }}{% endif %}</p>
  <ul class="facelove-bundle__gifts">
    {% for index in (1..3) %}
      {% liquid
        assign image_key = 'gift_image_' | append: index
        assign label_key = 'gift_label_' | append: index
        assign gift_image = block.settings[image_key]
      %}
      <li{% if forloop.first %} class="facelove-bundle__always-included"{% endif %}>
        <div class="facelove-bundle__image">
          {% if gift_image != blank %}{{ gift_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '(max-width: 749px) 49px, 58px', alt: '' }}{% endif %}
          <span class="facelove-bundle__lock" ref="locks[]" aria-hidden="true"{% if unlocked or forloop.first %} hidden{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
          <span class="facelove-bundle__check" ref="checks[]" aria-hidden="true"{% unless unlocked or forloop.first %} hidden{% endunless %}>{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
        </div>
        <strong><span>{{ 'facelove.free' | t }}</span>{{ block.settings[label_key] | remove: 'FREE ' | remove: 'Free ' | escape }}</strong>
      </li>
    {% endfor %}
  </ul>
  {% if block.settings.campaign_heading != blank %}
    <div class="facelove-bundle__campaign">
      <div><strong>{{ block.settings.campaign_heading | escape }}</strong><span>{{ block.settings.campaign_label | escape }}</span></div>
      {% if block.settings.show_progress %}<div class="facelove-bundle__progress" aria-hidden="true"><span style="width: {{ block.settings.progress }}%"></span></div>{% endif %}
      {% if block.settings.campaign_text != blank %}<p>{{ block.settings.campaign_text | escape }}</p>{% endif %}
    </div>
  {% endif %}
</facelove-bundle>
{% stylesheet %}
  .facelove-bundle { display: block; width: 100%; font-size: 0.75rem; padding-block-start: var(--fl-space-sm); }
  .facelove-bundle__gifts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; text-align: center; }
  .facelove-bundle__gifts li { color: var(--fl-color-muted); line-height: 1.35; }
  .facelove-bundle__gifts strong { display: block; max-width: 12ch; margin: auto; }
  .facelove-bundle__gifts strong > span { display: block; text-transform: uppercase; }
  .facelove-bundle__image { position: relative; width: 58px; height: 58px; margin: 0 auto var(--fl-space-sm); }
  .facelove-bundle__image img { width: 100%; height: 100%; object-fit: contain; filter: grayscale(1); opacity: 0.55; }
  .facelove-bundle__lock, .facelove-bundle__check { position: absolute; inset-block-end: 0; inset-inline-end: -3px; display: grid; place-items: center; width: 20px; height: 20px; border: 2px solid var(--fl-color-surface); border-radius: 50%; color: var(--fl-color-on-accent); background: var(--fl-color-muted); }
  .facelove-bundle__image svg { width: 12px; height: 12px; }
  .facelove-bundle__check { background: var(--fl-color-success); }
  .facelove-bundle__image > [hidden] { display: none; }
  .facelove-bundle[data-unlocked='true'] .facelove-bundle__image img { filter: none; opacity: 1; }
  .facelove-bundle[data-unlocked='true'] .facelove-bundle__gifts li { color: var(--fl-color-success); }
  .facelove-bundle .facelove-bundle__always-included { color: var(--fl-color-success); }
  .facelove-bundle__always-included .facelove-bundle__image img { filter: none; opacity: 1; }
  .facelove-bundle__campaign { padding: var(--fl-space-xl); margin-block-start: var(--fl-space-xl); background: var(--fl-color-well); border-radius: var(--fl-radius-control); color: var(--fl-color-accent-ink); }
  .facelove-bundle__campaign > div:first-child { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; }
  .facelove-bundle__campaign p { margin: var(--fl-space-md) 0 0; font-size: 0.75rem; }
  .facelove-bundle__progress { height: 6px; margin-block-start: var(--fl-space-md); background: var(--fl-color-rule); border-radius: var(--fl-radius-pill); overflow: hidden; }
  .facelove-bundle__progress span { height: 100%; display: block; background: var(--fl-color-accent); border-radius: inherit; }
  @media (max-width: 749px) {
    .facelove-bundle { padding-block-start: var(--fl-space-xs); font-size: 0.6875rem; }
    .facelove-bundle__image { width: 49px; height: 49px; margin-block-end: 6px; }
    .facelove-bundle__lock, .facelove-bundle__check { width: 17px; height: 17px; }
    .facelove-bundle__image svg { width: 10px; height: 10px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .facelove-bundle__image img { transition: opacity var(--fl-duration-state) var(--fl-ease); }
    .facelove-bundle__lock, .facelove-bundle__check { animation: facelove-perk-enter var(--fl-duration-state) var(--fl-ease); }
    @keyframes facelove-perk-enter { from { opacity: 0; transform: scale(0.7); } to { opacity: 1; transform: none; } }
  }
{% endstylesheet %}
{% schema %}
{
  "name":"t:names.facelove_bundle", "tag":null,
  "settings":[
    {"type":"text","id":"locked_heading","label":"t:settings.facelove_locked_heading"},
    {"type":"text","id":"unlocked_heading","label":"t:settings.facelove_unlocked_heading"},
    {"type":"image_picker","id":"gift_image_1","label":"t:settings.facelove_shipping_image"},
    {"type":"text","id":"gift_label_1","label":"t:settings.facelove_shipping_label"},
    {"type":"image_picker","id":"gift_image_2","label":"t:settings.facelove_gift_image"},
    {"type":"text","id":"gift_label_2","label":"t:settings.facelove_gift_label"},
    {"type":"image_picker","id":"gift_image_3","label":"t:settings.facelove_primer_image"},
    {"type":"text","id":"gift_label_3","label":"t:settings.facelove_primer_label"},
    {"type":"text","id":"campaign_heading","label":"t:settings.facelove_campaign_heading"},
    {"type":"text","id":"campaign_label","label":"t:settings.facelove_campaign_label"},
    {"type":"text","id":"campaign_text","label":"t:settings.text"},
    {"type":"checkbox","id":"show_progress","label":"t:settings.facelove_show_progress","default":false},
    {"type":"range","id":"progress","label":"t:settings.facelove_progress","min":0,"max":100,"step":1,"unit":"%","default":0}
  ],
  "presets":[{"name":"t:names.facelove_bundle","category":"t:categories.product"}]
}
{% endschema %}
