{% doc %}
  Decorative line icons for the product's practical benefits and refund promise.
  @param {string} name - shield, finish, coverage, moisture, or routine.
  @example
  {% render 'facelove-icon', name: 'shield' %}
{% enddoc %}
<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case name %}
    {% when 'shield' %}<path d="M16 3 27 7v9c0 6-6 10-11 13C11 26 5 22 5 16V7Z"/><path d="m10 15 4 4 8-8"/>
    {% when 'finish' %}<circle cx="16" cy="16" r="7"/><path d="M16 3v3m0 20v3M3 16h3m20 0h3M7 7l2 2m14 14 2 2M7 25l2-2M23 9l2-2"/>
    {% when 'coverage' %}<path d="m4 12 12-7 12 7-12 7Zm0 6 12 7 12-7M4 24l12 7 12-7" transform="translate(0 -2)"/>
    {% when 'moisture' %}<path d="M16 3c-2 5-10 12-10 18a10 10 0 0 0 20 0c0-6-8-13-10-18Z"/><path d="M11 21a5 5 0 0 0 5 5"/>
    {% when 'routine' %}<rect x="5" y="8" width="22" height="20" rx="4"/><path d="M11 8V6a5 5 0 0 1 10 0v2M11 16h10m-10 5h6"/>
  {% endcase %}
</svg>
