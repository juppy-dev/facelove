        "chapter_1": {
          "type": "chapter",
          "settings": {
            "heading": "Automatic color adjustment, always the perfect tone",
            "text": "<ul><li>It adapts perfectly to your skin tone.</li><li>No orange, grey or yellow tint</li><li>A shade that works for almost all women</li><li>No time wasted on complicated color choices.</li></ul>",
