          "type": "content",
          "settings": {
            "heading": "Moisturize first",
            "text": "<p>Prepare your skin with your usual moisturizer before applying foundation.</p>"
          }
        },
        "content_1": {
          "type": "content",
          "settings": {
            "heading": "Apply and blend",
            "text": "<p>Apply a small amount. Blend thoroughly with the built-in brush or your fingers.</p>"
          }
        },
        "content_2": {
          "type": "content",
          "settings": {
            "heading": "Build where you need it",
            "text": "<p>Add another light layer to the areas where you would like more coverage.</p>"
